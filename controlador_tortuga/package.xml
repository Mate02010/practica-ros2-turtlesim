<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>controlador_tortuga</name>
  <version>0.1.0</version>
  <description>Controlador de modos, círculo y trayectoria de tres puntos para turtlesim.</description>
  <maintainer email="brayan_mateo_bravo_l@todo.todo">brayan_mateo_bravo_l</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>turtlesim</depend>
  <depend>turtlesim_msgs</depend>
  <depend>controlador_tortuga_interfaces</depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
